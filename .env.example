# Supabase — https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_PROJECT_ID=your-project-ref
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-public-key

# Server-only — for scripts/create-admin-user.js (never expose in frontend)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret

# Production canonical URL (sitemap, SEO, Open Graph)
VITE_SITE_URL=https://www.nuzuul.com

# Cloudflare R2 — Edge Function / ops secrets only (never VITE_* / never commit real keys)
# Set these with: npx supabase secrets set KEY=value
# R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=shima-villas
# PUBLIC_R2_URL=https://pub-xxxxxxxx.r2.dev
# Also apply supabase/functions/r2-presign/cors.json on the R2 bucket and add your production origin.
